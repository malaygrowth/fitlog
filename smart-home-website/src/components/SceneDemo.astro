---
import { scenes } from '../data/site';

/**
 * The homepage moment. A visitor taps a scene and watches the room respond.
 * Nobody else in this category demonstrates the product on the page.
 *
 * Degrades honestly: with JavaScript off, the room sits in Evening and the
 * buttons are inert but readable. With reduced motion, states swap instantly
 * instead of animating.
 */
const initial = scenes.find((s) => s.id === 'evening') ?? scenes[0];
---

<div
  class="demo"
  id="scene-demo"
  data-scenes={JSON.stringify(scenes)}
  style={`--lvl:${initial.level};--curtain:${initial.curtain};--sky:${initial.sky};--glow:${initial.glow}`}
>
  <div class="room">
    <div class="wall"></div>
    <div class="window">
      <div class="sky"></div>
      <div class="curt curt--l"></div>
      <div class="curt curt--r"></div>
    </div>
    <div class="lamp-fx"></div>
    <div class="floorline"></div>
    <p class="voice">
      <span>Say:</span>
      <em data-out="voice">{initial.voice}</em>
    </p>
  </div>

  <div class="ctrl">
    <p class="eyebrow" style="color:var(--muted-on-night)">Living room</p>
    <div class="scenes" role="group" aria-label="Choose a scene">
      {
        scenes.map((s) => (
          <button
            type="button"
            data-scene={s.id}
            aria-pressed={s.id === initial.id ? 'true' : 'false'}
          >
            {s.label}
          </button>
        ))
      }
    </div>
    <p class="desc" data-out="desc">{initial.desc}</p>
    <div class="readout">
      <div><span class="k">Lights</span><span class="v" data-out="lights">{initial.readout.lights}</span></div>
      <div><span class="k">Curtains</span><span class="v" data-out="curtains">{initial.readout.curtains}</span></div>
      <div><span class="k">Climate</span><span class="v" data-out="climate">{initial.readout.climate}</span></div>
      <div><span class="k">Status</span><span class="v" data-out="status">{initial.readout.status}</span></div>
    </div>
  </div>
</div>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    background: var(--night);
    color: var(--ink-on-night);
    border: 1px solid var(--rule-night);
  }
  @media (max-width: 760px) {
    .demo { grid-template-columns: 1fr; }
  }

  .room {
    position: relative;
    min-height: 380px;
    overflow: hidden;
  }
  .wall {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        120% 80% at 50% 8%,
        color-mix(in srgb, var(--glow) calc(var(--lvl) * 46%), transparent) 0%,
        transparent 62%
      ),
      linear-gradient(#161a20, #0c0f13);
    transition: background 900ms ease;
  }
  .window {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 15%;
    bottom: 27%;
    background: linear-gradient(#20303f, #101a24);
    border: 1px solid #2c3742;
    overflow: hidden;
  }
  .sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(#3e5a72, #7e6a57);
    opacity: var(--sky);
    transition: opacity 900ms ease;
  }
  .curt {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 52%;
    background: linear-gradient(90deg, #2a2721, #3a362d 40%, #242119);
    transition: transform 1100ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* --curtain is how far the curtains are drawn back: 0% closed, 100% open */
  .curt--l { left: 0; transform: translateX(calc(-1 * var(--curtain))); }
  .curt--r { right: 0; transform: translateX(var(--curtain)); }
  .lamp-fx {
    position: absolute;
    left: 50%;
    top: 0;
    width: 58%;
    height: 64%;
    transform: translateX(-50%);
    background: radial-gradient(
      50% 60% at 50% 0%,
      color-mix(in srgb, var(--glow) 70%, transparent),
      transparent 70%
    );
    opacity: var(--lvl);
    transition: opacity 900ms ease, background 900ms ease;
    pointer-events: none;
  }
  .floorline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 23%;
    height: 1px;
    background: #232a32;
  }
  .voice {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 16px;
    display: flex;
    gap: 9px;
    align-items: baseline;
    font-size: 0.85rem;
    color: #c9c3b8;
  }
  .voice em {
    font-family: var(--accent-face);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--glow);
    transition: color 700ms ease;
  }

  .ctrl {
    padding: 24px;
    border-left: 1px solid var(--rule-night);
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  @media (max-width: 760px) {
    .ctrl { border-left: 0; border-top: 1px solid var(--rule-night); }
  }
  .scenes { display: flex; flex-wrap: wrap; gap: 8px; }
  .scenes button {
    font-family: var(--display);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 9px 14px;
    background: transparent;
    color: #b9c0c8;
    border: 1px solid #2e353e;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .scenes button:hover { border-color: #4b545e; color: var(--ink-on-night); }
  .scenes button[aria-pressed='true'] {
    background: var(--glow);
    border-color: var(--glow);
    color: #14100a;
  }
  .desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted-on-night);
    min-height: 3em;
  }
  .readout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--rule-night);
    border: 1px solid var(--rule-night);
    margin-top: auto;
  }
  .readout div {
    background: #12161b;
    padding: 12px 13px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .readout .k {
    font-family: var(--display);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-night);
  }
  .readout .v {
    font-family: var(--display);
    font-size: 1.3rem;
    color: var(--ink-on-night);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
</style>

<script>
  type Scene = {
    id: string;
    label: string;
    voice: string;
    desc: string;
    level: number;
    curtain: string;
    sky: number;
    glow: string;
    readout: { lights: string; curtains: string; climate: string; status: string };
  };

  const demo = document.getElementById('scene-demo');
  if (demo) {
    const scenes: Scene[] = JSON.parse(demo.dataset.scenes ?? '[]');
    const buttons = demo.querySelectorAll<HTMLButtonElement>('.scenes button');
    const out = (name: string) =>
      demo.querySelector<HTMLElement>(`[data-out="${name}"]`);

    const apply = (id: string) => {
      const s = scenes.find((x) => x.id === id);
      if (!s) return;

      demo.style.setProperty('--lvl', String(s.level));
      demo.style.setProperty('--curtain', s.curtain);
      demo.style.setProperty('--sky', String(s.sky));
      demo.style.setProperty('--glow', s.glow);

      const set = (name: string, value: string) => {
        const el = out(name);
        if (el) el.textContent = value;
      };
      set('voice', s.voice);
      set('desc', s.desc);
      set('lights', s.readout.lights);
      set('curtains', s.readout.curtains);
      set('climate', s.readout.climate);
      set('status', s.readout.status);

      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.scene === id)),
      );
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => apply(b.dataset.scene ?? '')),
    );
  }
</script>
