---
import '../styles/global.css';
import { site, whatsappLink } from '../data/site';
import { services } from '../data/services';

interface Props {
  title: string;
  description?: string;
  /** Pre-fills the WhatsApp message with what the visitor is reading */
  waContext?: string;
  /** Pages with their own prominent WhatsApp CTA suppress the floating one,
   *  so it never sits on top of the thing it duplicates. */
  hideWaFloat?: boolean;
}

const { title, description = site.description, waContext, hideWaFloat = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="preload"
      href="/fonts/oswald.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap bar">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Main">
          {
            [
              { href: '/services/', label: 'Services' },
              { href: '/projects/', label: 'Projects' },
              { href: '/how-it-works/', label: 'How it works' },
              { href: '/service-and-amc/', label: 'Service' },
              { href: '/journal/', label: 'Journal' },
            ].map((l) => (
              <a
                class="nav-secondary"
                href={l.href}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            ))
          }
          <a class="nav-cta" href="/estimate/" aria-current={isCurrent('/estimate/') ? 'page' : undefined}>
            Get an estimate
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="cols">
          <div>
            <h4>Services</h4>
            <ul>
              {
                services.map((s) => (
                  <li>
                    <a href={`/services/${s.slug}/`}>{s.name}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href="/projects/">Projects</a></li>
              <li><a href="/how-it-works/">How it works</a></li>
              <li><a href="/service-and-amc/">Service &amp; AMC</a></li>
              <li><a href="/for-designers/">For architects &amp; designers</a></li>
              <li><a href="/journal/">Journal</a></li>
              <li><a href="/privacy/">Privacy, plainly</a></li>
            </ul>
          </div>
          <div>
            <h4>Talk to us</h4>
            <ul>
              <li><a href="/estimate/">Get an estimate</a></li>
              <li><a href={whatsappLink(waContext)} rel="noopener">WhatsApp</a></li>
              <li><a href={site.phoneHref}>{site.phone}</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href="/contact/">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4>Where we work</h4>
            <ul>
              {
                site.cities.map((c) => (
                  <li>
                    <a href={`/areas/${c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`}>
                      {c}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="base">
          <span>&copy; {new Date().getFullYear()} {site.name}</span>
          <span>Switches, curtains, scenes, climate and voice.</span>
        </div>
      </div>
    </footer>

    {
      !hideWaFloat && (
        <a
          class="btn btn--wa wa-float"
          href={whatsappLink(waContext)}
          rel="noopener"
          aria-label="Message us on WhatsApp"
        >
          WhatsApp us
        </a>
      )
    }
  </body>
</html>
